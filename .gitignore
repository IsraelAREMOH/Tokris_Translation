# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local-only dev workarounds (machine/network-specific, never shared)
dev-insecure.ps1

# internal project instructions + raw source content — kept locally, not in
# the public repo. Image assets are the exception: they're tracked so they
# can be referenced/deployed from the repo, everything else (docs, etc.)
# stays ignored.
/CLAUDE.md
/Assets/*
!/Assets/*.jpg
!/Assets/*.jpeg
!/Assets/*.png
!/Assets/*.webp
!/Assets/*.gif
!/Assets/*.svg

# typescript
*.tsbuildinfo
next-env.d.ts
